-# Renders one Originality.ai scan result. The block scores are read from
-# results.ai for both classic models and AI Allowance mode.
- ai = originality_result['results']['ai']
%br
%h4= "#{label} Result:"

%p Model: #{ai['aiModel']}
%p
  Prediction:
  - if ai['classification']['AI'] == 1
    AI written
  - else
    Human written
%p AI confidence: #{ai['confidence']['AI']}
%p Human confidence: #{ai['confidence']['Original']}
%table.table.table--striped
  %thead
    %tr
      %th Block
      %th Words
      %th AI score
  %tbody
    - ai['blocks'].each_with_index do |block, index|
      %tr
        %td= index + 1
        %td= block['text'].to_s.split.size
        %td= block['result']['fake']&.round(4)
%a.button{ href: originality_result['results']['properties']['publicLink'], target: '_blank' }= "#{label} Report"
%br
