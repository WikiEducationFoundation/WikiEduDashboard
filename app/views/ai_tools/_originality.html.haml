-# Renders one Originality.ai 5.0 or 5.0 Max scan result: the verdict, the share of
-# the text judged AI-assisted, and the score of each segment Originality scored.
- ai = result['results']['ai']
%br
%h4= "#{label} Result:"

%p Model: #{ai['model']}
%p Prediction: #{ai['prediction_label']}
%p AI-assisted: #{ai['ai_assisted_percent']}%
%table.table.table--striped
  %thead
    %tr
      %th Segment
      %th Words
      %th AI score
  %tbody
    - Array(ai['sentences']).each_with_index do |segment, index|
      %tr
        %td= index + 1
        %td= segment['text'].to_s.split.size
        %td= segment['ai_score']&.round(4)
%a.button{ href: result['results']['properties']['publicLink'], target: '_blank' }= "#{label} Report"
%br
