- content_for :before_title, 'AI Tools — '
%header.main-page
  .container
    %h1 AI Tools
.container
  %section
    .section-header
      %h2= "Compare different AI detectors"
      = form_with url: "/ai_tools/compare_ai_detectors", method: :post do |form|
        = label_tag :article_or_diff_url, 'Diff or article URL:'
        = text_field_tag :article_or_diff_url
        %br
        %br
        = label_tag :plain_text, 'Plain text:'
        %br
        = text_area_tag :plain_text, nil, rows: 5, cols: 100
        %hr
        %h3 Models
        -# Originality.ai checks spend a limited credit balance, so only the
        -# Pangram detectors are ticked by default.
        - AiDetector.keys.each do |key|
          %div.checkbox-group
            %label
              = check_box_tag(key.to_sym, '1', AiDetector.for(key).pangram?)
              = key
        %br
        .button= submit_tag 'Submit'
      %hr
    - if @url_error
      %p.notice= @url_error
    - elsif @url
      %br
      %a{ href: @url, target: '_blank' }= @url
      %br
    - @selected_detectors&.each do |detector|
      - if @errors[detector.key]
        %p.notice= "#{detector.key}: #{@errors[detector.key]}"
      - elsif @results.key?(detector.key)
        = render detector.partial, result: @results[detector.key], label: detector.key
      - else
        %p.notice= "#{detector.key}: no result"
