- content_for(:title) { 'Metrics' }
.container.metrics-glossary
  %h1 Metrics
  .metrics-glossary__disclosure{ role: 'note' }
    %p
      This glossary was drafted by Claude Code, an AI coding agent, from the
      Dashboard's source code, and is checked against that code by automated
      tests. Where we found the same metric calculated differently in different
      places, we list it as a known inconsistency rather than hiding it. If
      something here looks wrong, please
      = succeed '.' do
        = link_to 'let us know', "#{MetricsGlossary::REPO_URL}/issues"
  %p
    How the numbers on a course page are calculated, grouped the way they
    appear there. Select a number in an example, or an entry below it, to see
    how it's worked out.

  %nav.metrics-glossary__contents{ 'aria-label': 'Contents' }
    %ul
      - @sections.each do |section|
        %li= link_to section.title, "##{section.key}"
      - if @divergences.any?
        %li= link_to 'Known inconsistencies', '#known-inconsistencies'
  .metrics-glossary__controls
    %button.button.border.small{ type: 'button', data: { glossary_toggle: 'open' } } Expand all
    %button.button.border.small{ type: 'button', data: { glossary_toggle: 'close' } } Collapse all

  - @sections.each do |section|
    %section.metrics-glossary__section{ id: section.key, 'aria-labelledby': "#{section.key}-heading" }
      %h2{ id: "#{section.key}-heading" }= section.title
      = glossary_markdown(section.intro)
      - if section.visual.present?
        %figure.metrics-glossary__visual
          = render "about_this_site/metrics_visuals/#{section.visual}"
          %figcaption Example numbers, not from a real course.
      - section.metrics.each do |metric|
        = render 'metrics_glossary_entry', metric:
      - if section.notes.any?
        = render 'metrics_glossary_notes', section:

  - if @divergences.any?
    %section.metrics-glossary__section#known-inconsistencies{ 'aria-labelledby': 'known-inconsistencies-heading' }
      %h2#known-inconsistencies-heading Known inconsistencies
      %p
        Places where one name is calculated in more than one way. Each has a
        status: not yet decided, intentional, or a bug (usually with an issue to
        fix it).
      - @divergences.each do |divergence|
        = render 'metrics_glossary_divergence', divergence:

:javascript
  // Open the entry a link points at (from another entry, the contents, or an
  // incoming /metrics#key URL), and wire up the expand/collapse buttons.
  (function () {
    function openEntry(hash) {
      var target = document.getElementById(decodeURIComponent(hash.slice(1)));
      if (target && target.tagName === 'DETAILS') target.open = true;
    }
    // Clicking a link to the current hash doesn't fire hashchange, so links
    // are handled directly, before the browser scrolls to the target.
    document.querySelectorAll('.metrics-glossary a[href^="#"]').forEach(function (link) {
      link.addEventListener('click', function () { openEntry(link.getAttribute('href')); });
    });
    window.addEventListener('hashchange', function () { openEntry(location.hash); });
    if (location.hash) {
      openEntry(location.hash);
      var target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (target) target.scrollIntoView();
    }
    document.querySelectorAll('[data-glossary-toggle]').forEach(function (button) {
      button.addEventListener('click', function () {
        var open = button.dataset.glossaryToggle === 'open';
        document.querySelectorAll('.metrics-glossary__entry').forEach(function (entry) {
          entry.open = open;
        });
      });
    });
  })();
