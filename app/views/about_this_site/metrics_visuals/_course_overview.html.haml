-# A static copy of the course overview's stat block (OverviewStats), with
-# example numbers. Each number links to its entry; the smaller lines are the
-# details the real page shows when you hover over a number.
.stat-display.metrics-glossary__stat-display
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#articles_created' }
      .stat-display__value 3
      %small Articles Created
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#articles_edited' }
      .stat-display__value 66
      %small Articles Edited
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#total_edits' }
      .stat-display__value 417
      %small Total Edits
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#editors' }
      .stat-display__value 24
      %small Student Editors
    %a.metrics-glossary__visual-detail{ href: '#trained' } 21 are up-to-date with training
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#words_added' }
      .stat-display__value 70.9K
      %small Words Added
    %a.metrics-glossary__visual-detail{ href: '#characters_added' } or Bytes Added
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#references_added' }
      .stat-display__value 382
      %small References Added
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#article_views' }
      .stat-display__value 1.44M
      %small Article Views
  .stat-display__stat
    %a.metrics-glossary__visual-link{ href: '#commons_uploads' }
      .stat-display__value 12
      %small Commons Uploads
    %a.metrics-glossary__visual-detail{ href: '#uploads_in_use' } 8 files used in articles
    %a.metrics-glossary__visual-detail{ href: '#upload_usages' } 31 total usages across languages
