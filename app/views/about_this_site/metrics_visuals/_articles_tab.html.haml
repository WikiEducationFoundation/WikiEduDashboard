-# A static copy of the Articles tab list (ArticleList), with example rows.
-# Each column heading links to its entry or note. Class isn't documented yet.
.metrics-glossary__table-wrapper
  %table.table.metrics-glossary__table
    %thead
      %tr
        %th Class
        %th Title
        %th
          %a{ href: '#articles_tab--words_added' } Words Added
        %th
          %a{ href: '#articles_tab--references_added' } References Added
        %th
          %a{ href: '#articles_tab--article_views' } Views
    %tbody
      %tr
        %td B
        %td Coral reef
        %td 1,240
        %td 14
        %td 18.2K
      %tr
        %td C
        %td Mangrove forest
        %td 865
        %td 9
        %td 6.4K
