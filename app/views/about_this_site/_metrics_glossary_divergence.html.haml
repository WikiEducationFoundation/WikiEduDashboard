%details.metrics-glossary__entry{ id: divergence.key }
  %summary
    %h3.metrics-glossary__entry-name= divergence.title
    %span.metrics-glossary__entry-summary
      = glossary_divergence_status_label(divergence)
      &middot;
      Affects
      = safe_join(divergence.metric_keys.map { |key| glossary_metric_name(key) }, ', ')
  .metrics-glossary__entry-body
    %p.metrics-glossary__status
      Status:
      = glossary_divergence_status(divergence)
    = glossary_markdown(divergence.description)
    %p
      Affects:
      = safe_join(divergence.metric_keys.map { |key| glossary_metric_link(key) }, ', ')
    - if divergence.code.any?
      %h4 Code
      %ul.metrics-glossary__code
        - divergence.code.each do |ref|
          %li= glossary_code_link(ref)
