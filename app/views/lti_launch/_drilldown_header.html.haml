- # Header line for every linked-course iframe: the view's title on the
- # left; the bound course's title on the right, linking out to the
- # Dashboard course in a new tab (this replaces per-view "Open course"
- # buttons). Locals: title (required), course, linked_check (optional).
.lti-iframe__header
  %h1.lti-iframe__drilldown-title
    = title
    - if defined?(linked_check) && linked_check
      %span.lti-iframe__linked-check{ role: 'img', 'aria-label': t('lti.status.linked') } ✓
  - if course
    = link_to "/courses/#{course.slug}", target: '_blank', rel: 'noopener',
              class: 'lti-iframe__course-link' do
      = course.title
      %span.icon.icon-z-external-link{ 'aria-hidden': 'true' }
- # A submission launch (SpeedGrader, or a submission page) is about one student, and
- # the view below is narrowed to them. Name them, and give the instructor the way
- # through to everything the iframe can't hold.
- if @focus_user
  = render 'lti_launch/submission_focus', user: @focus_user, course: course
