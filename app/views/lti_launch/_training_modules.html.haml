- # One row per assigned training module: the module, when it's due, and this
- # student's status. Shared by a student's own drill-down and the single-student
- # submission view, where an instructor grading the column needs to see WHICH
- # trainings are done, not only how many. Locals: rows (required).
.lti-table-scroll
  %table.lti-assignment-roster
    %thead
      %tr
        %th= t('lti.assignment_view.trainings.module')
        %th= t('lti.assignment_view.trainings.due_date')
        %th= t('lti.assignment_view.roster.status')
    %tbody
      - rows.each do |training|
        %tr
          %td
            = link_to training.name, training.training_url,
                      target: '_blank', rel: 'noopener'
          %td= training.due_date&.strftime('%b %-d, %Y')
          %td
            %span.lti-status{ class: training.completed? ? 'lti-status--done' : 'lti-status--pending' }
              = training.status
            - if training.completion_date
              %span.lti-trainings__completed-at
                = training.completion_date.strftime('%b %-d, %Y')
