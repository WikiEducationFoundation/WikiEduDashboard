- # One student's whole state of work, for a disclosure row of the LTI 1.1
- # instructor roster: edit statistics and the way out to their Dashboard details
- # page, then the same sections the student sees on their own launch
- # (_student_overview_sections, over their StudentStatusContext), plus their
- # peer reviews. Every link opens in a new tab, since the full Dashboard cannot
- # render inside the Canvas iframe.
- # Locals: row (InstructorRosterContext::StudentRow).
.lti-roster__student
  .lti-roster__stats
    %span
      = t('lti.assignment_view.article_work.characters')
      = number_with_delimiter(row.character_sum_ms)
    %span
      = t('lti.assignment_view.article_work.references')
      = number_with_delimiter(row.references_count)
    = link_to row.details_url, target: '_blank', rel: 'noopener', class: 'lti-roster__details-link' do
      = t('lti.assignment_view.submission.details')
      %span.icon.icon-z-external-link{ 'aria-hidden': 'true' }

  = render 'lti_launch/student_overview_sections', status: row.status,
                                                    articles_heading: t('courses.assignment_headings.assigned_articles'),
                                                    sandbox_label: t('lti.assignment_view.roster.sandbox')

  - if row.peer_review_progress.total_count.positive?
    %section.lti-overview-section
      %h2
        = t('lti.assignment_view.peer_review.reviews')
        %span.lti-overview-count
          = "#{row.peer_review_progress.completed_count} / #{row.peer_review_progress.total_count}"
      = render 'lti_launch/peer_reviews', reviews: row.peer_reviews
