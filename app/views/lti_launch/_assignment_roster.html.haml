- roster = @context.roster
- if roster.empty?
  %p.lti-iframe__empty= t('lti.assignment_view.roster.empty')
- else
  .lti-table-scroll
    %table.lti-assignment-roster
      %thead
        %tr
          %th= t('lti.assignment_view.roster.student')
          - # An article-selection column reports which article each student took
          - # on; "Completed" says nothing an instructor can act on there.
          - if @context.article_selection?
            %th= t('lti.assignment_view.roster.assigned_article')
          - else
            %th= t('lti.assignment_view.roster.status')
          %th= t('lti.assignment_view.roster.sandbox')
      %tbody
        - roster.each_with_index do |row, i|
          %tr
            %td= row.name
            - if @context.article_selection?
              %td= render 'lti_launch/assigned_articles', articles: row.assigned_articles
            - else
              %td
                %span.lti-status{ class: lti_progress_pill_class(row.progress_state) }
                  = lti_progress_status_label(row.progress_state)
            %td
              - if row.sandbox_url
                .lti-sandbox__actions
                  %button.lti-sandbox__toggle{ type: 'button', 'data-sandbox-url': row.sandbox_url, 'aria-controls': "sandbox-#{i}", 'aria-expanded': 'false', 'data-label-show': t('lti.assignment_view.show'), 'data-label-hide': t('lti.assignment_view.hide') }
                    = t('lti.assignment_view.show')
                  = link_to row.sandbox_url, target: '_blank', rel: 'noopener', class: 'lti-sandbox__link' do
                    = t('lti.assignment_view.open_on_wikipedia')
                    %span.icon.icon-z-external-link{ 'aria-hidden': 'true' }
          - if row.sandbox_url
            %tr.lti-sandbox__detail{ id: "sandbox-#{i}", hidden: true }
              %td{ colspan: 3 }
                .lti-sandbox__content
          - # The whole state of this student's article, on the stages of the
          - # writing process that call for it. Labelled, like the student's own
          - # panel is: a bare block of sandbox links under a roster row doesn't
          - # say what it is.
          - if @context.article_panel?
            %tr.lti-article-work__row
              %td{ colspan: 3 }
                %h3.lti-article-work__heading= t('lti.assignment_view.article_work.header')
                = render 'lti_launch/article_work', articles: row.assigned_articles,
                                                   scope: "row-#{i}"
