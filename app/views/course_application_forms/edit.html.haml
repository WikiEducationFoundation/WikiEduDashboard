-# Admin-only settings for a Scholars & Scientists course's application form.
-# See CourseApplicationFormsController. Expects @course, @form and
-# @question_group_choices (the groups that may join the form).
- content_for :before_title, "#{t('course_application_forms.title')} — "

%header.main-page
  .container
    %h1= t('course_application_forms.title')
    %p
      = link_to @course.title, "/courses/#{@course.slug}"
      ·
      = link_to t('course_application_reviews.title'), "/courses/#{@course.slug}/applications"

.container.course-application-form
  - if @form.errors.any?
    .notification
      %ul
        - @form.errors.full_messages.each do |message|
          %li= message

  = form_with url: "/courses/#{@course.slug}/application_form", method: :patch,
              scope: :course_application_form, local: true do |f|
    .form-group
      -# Explicit ids: form_with generates none in this app, and the labels need them.
      = f.check_box :open, checked: @form.open, id: 'course_application_form_open'
      = f.label :open, t('course_application_forms.open'), for: 'course_application_form_open'

    .form-group
      = f.label :intro, t('course_application_forms.intro'), for: 'course_application_form_intro'
      = f.text_area :intro, value: @form.intro, rows: 6, id: 'course_application_form_intro'

    .form-group
      = f.label :acceptance_email, t('course_application_forms.acceptance_email'),
                for: 'course_application_form_acceptance_email'
      %p#course_application_form_acceptance_email_help
        = t('course_application_forms.acceptance_email_help',
            sender: CourseApplicationMailer.sender_description)
      = f.text_area :acceptance_email, value: @form.acceptance_email, rows: 10,
                    id: 'course_application_form_acceptance_email',
                    aria: { describedby: 'course_application_form_acceptance_email_help' }

    %h2= t('course_application_forms.question_groups')
    %p= t('course_application_forms.question_groups_help')
    -# The groups on the form, asked in list order. application_form_settings.js
    -# adds drag-and-drop reordering and the Move, Remove and Add buttons. The
    -# blank id keeps the list present in the params when every group is removed.
    = hidden_field_tag 'course_application_form[question_group_ids][]', '', id: nil
    %ol.course-application-form__groups{ data: { question_group_list: true } }
      - @form.question_groups.each do |group|
        = render 'question_group_row', group:, edit_path: rapidfire.edit_question_group_path(group)
    %template{ data: { question_group_row_template: true } }
      = render 'question_group_row', group: Rapidfire::QuestionGroup.new(id: 0, name: ''),
               edit_path: rapidfire.edit_question_group_path('ID')

    - if @question_group_choices.empty? && @form.question_group_ids.empty?
      -# The same message as the Rapidfire question group admin's empty state.
      %p
        = t('question_groups.none')
        = link_to t('question_groups.create_one'), rapidfire.new_question_group_path
    - else
      -# Shown even with nothing to offer yet, so a removed group can be added back.
      -# Without JavaScript, the chosen group joins the end of the list on save.
      .course-application-form__add
        = label_tag 'course_application_form_add_question_group_id',
                    t('course_application_forms.question_group')
        = select_tag 'course_application_form[add_question_group_id]',
                     options_from_collection_for_select(@question_group_choices, :id, :name),
                     include_blank: true, id: 'course_application_form_add_question_group_id',
                     data: { question_group_add_select: true }
        %button.button{ type: 'button', data: { question_group_add: true } }
          = t('course_application_forms.add')

    = f.submit t('course_application_forms.save'), class: 'button dark'
= hot_javascript_tag 'application_form_settings'
