= render 'admin_header'
.block.block--clear

  %h2 Editing Question Groups for "#{@survey.name}" Survey

  = simple_form_for(@survey) do |f|
    = f.error_notification

    .form-input
      -# Groups on course application forms are kept out of surveys, so their
      -# answers come only from applications.
      = f.association :rapidfire_question_groups, as: :check_boxes,
        collection: Rapidfire::QuestionGroup.where.not(id: CourseApplicationForm.question_group_ids_in_use)

    .form-actions
      = f.button :submit, "Update Question Groups", :class => 'button dark'
