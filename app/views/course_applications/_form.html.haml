-# The application questions: every question group on the course's form, in
-# order, as one form submitted in one request. Each question is a card; a run
-# of grouped multiple-choice questions is one matrix card (see
-# CourseApplicationsHelper). course_application.js shows and hides conditional
-# questions; without it, every question is shown.
- if @invalid
  .module.course-application__invalid{ role: 'alert' }
    %p= t('error.form_errors')

= form_with url: "/courses/#{@course.slug}/apply", method: :post, local: true,
            html: { class: 'course-application__form', data: { course_application_form: true } } do
  - @form.question_groups.each do |group|
    - application_question_layout(group.questions.to_a).each do |kind, *rest|
      - if kind == :matrix
        - title, questions = rest
        = render 'matrix', title:, questions:, answers: @answers_by_question_id
      - else
        = render 'question', question: rest.first, answer: @answers_by_question_id[rest.first.id]
  = submit_tag t('course_applications.submit'), class: 'button dark'

= hot_javascript_tag 'course_application'
