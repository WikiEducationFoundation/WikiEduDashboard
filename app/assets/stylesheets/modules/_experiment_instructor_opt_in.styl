// Styling for the standalone instructor opt-in page for research experiments
// (experiments/instructor_opt_in/show.html.haml).
.instructor-opt-in
  margin 40px auto
  max-width 720px
  h1
    font-size 1.563em
    font-weight 300
    margin-bottom 15px
  .instructor-opt-in__courses
    list-style disc
    margin 15px 0 25px
    padding-left 25px
    li
      margin-bottom 5px
  .instructor-opt-in__status
    color #676767
    margin-left 10px
  .instructor-opt-in__actions
    display flex
    gap 10px
