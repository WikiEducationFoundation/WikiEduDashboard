// Instructor-facing Assignments tab (components/assignments_tab). The grader
// reuses the Students tab's two-pane layout (.users-articles).
.assignments-tab
  padding-top 20px

  .assignments-tab__kind
    color $text_med
    display block
    font-size 12px

  .assignments-tab__meta .assignments-tab__kind
    display inline

  .assignments-tab__header
    margin-bottom 15px
    h3
      margin 5px 0

  .assignments-tab__state
    font-weight 600
    white-space nowrap
  .assignments-tab__state--complete
    color $success_text
  .assignments-tab__state--in_progress
    color $brand_primary
  .assignments-tab__state--not_started
    color $text_med

  .assignments-tab__overdue, .assignments-tab__late
    color $warning_text
    font-weight 600
  .assignments-tab__overdue
    margin-left 8px

  .assignments-tab__overdue-count
    color $warning_text
    font-weight 600

  .assignments-tab__filter
    display inline-block
    margin-bottom 10px
    select
      margin-left 5px

  .assignments-tab__article
    margin-bottom 10px
    p
      margin-bottom 3px

  .assignments-tab__article-status
    color $text_med
    font-size 13px

  .assignments-tab__pages
    list-style none
    margin 0 0 5px

  .assignments-tab__stats
    display grid
    gap 2px 10px
    grid-template-columns max-content max-content
    dd
      margin 0

  // The grader's top bar: the assignment's heading, with previous/next on
  // the right, above the student list and the student's work.
  .assignments-tab__grader-top
    align-items flex-end
    display flex
    flex-wrap wrap
    gap 10px 20px
    justify-content space-between
    margin-bottom 15px
    .assignments-tab__header
      margin-bottom 0

  .assignments-tab__grader-nav
    align-items center
    display flex
    gap 12px
    .button
      margin 0
    .button:disabled
      cursor default
      opacity 0.5

  .assignments-tab__position
    color $text_med
    min-width 3.5em
    text-align center

  .assignments-tab__grader .student .assignments-tab__state
    font-size 12px

  .assignments-tab__grader li.student.selected .assignments-tab__state
    color white

  // The open assignment's drawer in the list.
  .assignments-tab__list > tbody > .drawer > td
    background white
    padding 15px 20px
    .table
      margin-bottom 0

  .assignments-tab__pages--inline
    font-size 14px

  .assignments-tab__exercise-count
    color $text_med
    font-size 14px

  .assignments-tab__exercises
    margin-top 10px
    h5
      margin-bottom 5px
    ul
      list-style none
      margin 0
    li
      margin-bottom 4px

  // Inline sandbox previews: a scrollable, bordered excerpt of the wiki page.
  .assignments-tab__preview-panel
    background white
    border 1px solid $border_lt
    margin 8px 0 12px
    max-height 480px
    overflow auto
    padding 10px 15px
    &[hidden]
      display none

  // The assigned article's row: tinted, with an accent bar and a bolder title.
  .assignments-tab__list > tbody > tr.assignments-tab__row--article
    background-color lighten($brand_primary, 90%)
    > td
      font-weight 600
    > td:first-child
      border-left 5px solid $brand_primary
      color $brand_primary
      font-size 17px
    .assignments-tab__kind
      font-weight normal
