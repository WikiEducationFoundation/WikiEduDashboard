body.training .breadcrumbs
  margin 0

body.training nav.top-nav
  position relative
  color $type_medium

.training__slide__nav h3 a
  color #fff
  text-decoration none

.breadcrumbs
  list-style none
  font-size 15px
  li
    display inline
    margin 0
    & + li::before
      content " > "

.training__slide-header
  position relative
  height auto
  padding 0
  background $training_primary
  +below(desktop - 1)
    margin-top 50px
  ol.breadcrumbs
    width 85%
    @extends .breadcrumbs
    color $breadcrumb_light_text
    text-align left
    margin-top 4px
    padding 0 12px
    a
      color #fff
      text-decoration none
      font-weight 600
      letter-spacing 1px
      &:hover
        text-decoration underline
    li
      color #fff
      &:first-child a
        color $breadcrumb_light_text
        font-weight 400
        letter-spacing 0
  .pop
    font-size 15px
  .training__nav-container
    display flex
    align-items center
    justify-content space-between
    padding 0 40px
    gap 30px
    #get-help-btn
      background-color #e5e7eb
      color #1f2937
    .training__breadcrumbs
      flex 1
      min-width 0
      ol, ul, .breadcrumbs
        margin 0
        padding 0
    .training__actions
      display flex
      align-items center
      gap 1rem
      .training__slide__nav
        position static
        float none
        left auto
        right auto
        margin 0
      .nav__button
        position static
        float none
        left auto
        right auto
        margin 0

  +below(desktop)
    padding 8px 0
    .training__nav-container
      flex-direction column
      align-items stretch
      gap 8px
      padding 0 16px
    .training__actions
      flex-direction column
      align-items center
      justify-content center
      gap 8px
      width 100%
      .nav__button
        display flex
        justify-content center
        align-items center
        width 100%
        margin 0
      .training__slide__nav
        justify-content center
        gap 6px
        position static
        float none
        left auto
        right auto
        top auto
        width auto
        height auto
        padding 8px 12px
        margin 0
    .training__breadcrumbs
      text-align center
    .pop__container
      display flex
      justify-content center
      width 100%
      .pop
        left 50%
        right auto
        transform translateX(-50%) scale(.7, .7)
        -webkit-transform translateX(-50%) scale(.7, .7)
        width 90vw
        max-width 360px
        &.open
          transform translateX(-50%) scale(1, 1)
          -webkit-transform translateX(-50%) scale(1, 1)
        &:before,
        &.open:before,
        &.right:before
          left 50%
          right auto
          margin-left -6px
    .slide__menu__nav__dropdown
      top 100%
      left 50%
      right auto
      transform translateX(-50%)
      width 90vw
      max-width 360px
      z-index 1000
.training__show
  ol.breadcrumbs
    width 66%
    @extends .breadcrumbs
    margin-bottom -23px
    li
      margin-left 0
      padding-left 0
    a
      color $type_light
      font-size 15px
  +below(tablet)
    margin-top 23px
    ol.breadcrumbs
      margin 70px 52px 0px 10px
      width 100%

a.slide-nav
  max-width 45%
  display block
  position absolute
  @extends .truncated-text
  +below(tablet)
    max-width 55%

.training__slide__nav
  cursor pointer
  display flex
  flex-direction row-reverse
  align-items center
  gap 6px
  position absolute
  right 70px
  top 0px
  color #fff
  height 55px
  width 192px
  padding 19px 12px 12px 12px
  .training__slide__page-label
    font-weight 400
    font-size 15px
    letter-spacing 0.35px

.dropdown__close
  cursor pointer
  position absolute
  top 11px
  right 10px
  font-size 23px
  font-weight 600

.hamburger
  margin 2px 0 0 10px

.hamburger__bar
  background #fff
  display block
  height 2px
  width 14px
  margin 2px

.slide__menu__nav__dropdown
  float left
  position absolute
  top 40px
  right 10px
  background $light_bg
  padding 5px 0
  width 275px
  box-shadow 3px 3px 6px rgba(0,0,0,0.3)
  z-index 999
  h1
    margin-bottom 15px
    padding 16px 16px 0
  ol
    list-style none
  li
    font-size 17px
    line-height 21px
    margin 10px 0
    padding-left 0
    border-top 2px solid $border_lightest
    padding 14px 15px 5px 15px
    color $type_dark
    font-weight 400
    &.current
      font-weight 600
      color $training_primary
      a
        opacity 1
        color $training_primary
    a
      @extends .truncated-text
      display block
      color $type_dark
      text-decoration none
      &:hover
        text-decoration underline
@media only screen and (max-width: 500px)
  body.training nav.ham-nav
    position fixed
