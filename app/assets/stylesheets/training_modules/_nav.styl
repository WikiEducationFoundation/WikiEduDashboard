body.training .breadcrumbs
  margin 0

body.training nav.top-nav
  position relative
  color $type_medium

.training__slide__nav h3 a
  color #fff
  text-decoration none

.breadcrumbs
  list-style none
  font-size 15px
  li
    display inline
    margin 0
    & + li::before
      content " > "

.training__slide-header
  position relative
  padding 16px 0
  background $training_primary
  +below(desktop - 1)
    margin-top 50px

  .training__nav-container
    display flex
    align-items center
    justify-content space-between
    padding 0 40px
    gap 30px

    .training-btn
      background-color #e5e7eb
      color #1f2937

    .training__breadcrumbs
      flex 1
      min-width 0

      ol, ul, .breadcrumbs
        margin 0
        padding 0

    .training__actions
      display flex
      align-items center
      gap 230px

  +below(desktop)
    padding 8px 0 !important

    /* 1. Stack all header containers vertically */
    .training__nav-container,
    .training__actions
      display flex !important
      flex-direction column !important
      align-items center !important
      justify-content center !important
      width 100% !important
      gap 8px !important
      padding 0 !important
      margin 0 auto !important

    /* 3. Center Breadcrumbs */
    .training__breadcrumbs
      width 100% !important
      text-align center !important
      display flex !important
      justify-content center !important

    /* 4. Center Get Help Container */
    .nav__button
      position relative !important
      display flex !important
      justify-content center !important
      align-items center !important
      width 100% !important
      margin 0 auto !important

      button, a, .training-btn, #get-help-button
        display inline-block !important
        margin 0 auto !important
        float none !important

    /* 5. FIX: Force Navigation Label Container to exact center */
    .hamburger-wrapper,
    .training__slide__nav
      position relative !important
      display flex !important
      justify-content center !important
      align-items center !important
      width 100% !important
      max-width 100% !important
      height auto !important
      padding 0 !important
      margin 0 auto !important
      float none !important
      left auto !important
      right auto !important
      gap 6px !important

      /* Reset nested inline margins/widths pulling Page X of Y left */
      > *,
      .training__slide__page-label,
      .hamburger
        margin 0 !important
        position static !important
        float none !important

      .training__slide__page-label
        order 1 !important

      .hamburger
        order 2 !important

    /* 7. Center Table of Contents dropdown on mobile viewports */
    .slide__menu__nav__dropdown
      position absolute !important
      top 100% !important
      left 50% !important
      right auto !important
      transform translateX(-50%) !important
      width 90vw !important
      max-width 360px !important
      z-index 1000 !important
  ol.breadcrumbs
    display flex
    @extends .breadcrumbs
    color $breadcrumb_light_text
    text-align left
    margin-top 4px
    padding 0 12px
    a
      color #fff
      text-decoration none
      font-weight 600
      letter-spacing 1px
      &:hover
        text-decoration underline
    li
      color #fff
      &:first-child a
        color $breadcrumb_light_text
        font-weight 400
        letter-spacing 0
  +below(tablet)
    padding 62px 0 16px 0

.training__show
  ol.breadcrumbs
    width 66%
    @extends .breadcrumbs
    margin-bottom -23px
    li
      margin-left 0
      padding-left 0
    a
      color $type_light
      font-size 15px
  +below(tablet)
    margin-top 23px
    ol.breadcrumbs
      margin 70px 52px 0px 10px
      width 100%

a.slide-nav
  max-width 45%
  display block
  position absolute
  @extends .truncated-text
  +below(tablet)
    max-width 55%

.training__slide__nav
  cursor pointer
  display inline-block
  position absolute
  right 70px
  top 0px
  color #fff
  height 55px
  width 192px
  padding 19px 12px 12px 12px
  .training__slide__page-label
    font-weight 400
    font-size 15px
    letter-spacing 0.35px

.dropdown__close
  cursor pointer
  position absolute
  top 11px
  right 10px
  font-size 23px
  font-weight 600

.hamburger
  margin 2px 0 0 10px

.hamburger__bar
  background #fff
  display block
  height 2px
  width 14px
  margin 2px

.slide__menu__nav__dropdown
  float left
  position absolute
  top 40px
  right 10px
  background $light_bg
  padding 5px 0
  width 275px
  box-shadow 3px 3px 6px rgba(0,0,0,0.3)
  z-index 999
  h1
    margin-bottom 15px
    padding 16px 16px 0
  ol
    list-style none
  li
    font-size 17px
    line-height 21px
    margin 10px 0
    padding-left 0
    border-top 2px solid $border_lightest
    padding 14px 15px 5px 15px
    color $type_dark
    font-weight 400
    &.current
      font-weight 600
      color $training_primary
      a
        opacity 1
        color $training_primary
    a
      @extends .truncated-text
      display block
      color $type_dark
      text-decoration none
      &:hover
        text-decoration underline
@media only screen and (max-width: 500px)
  body.training nav.ham-nav
    position fixed
